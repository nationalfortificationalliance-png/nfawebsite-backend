{
    "kind": "collectionType",
    "collectionName": "partners",
    "info": {
        "singularName": "partner",
        "pluralName": "partners",
        "displayName": "Partners – Partner Organizations",
        "description": "Project partner organisations"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "name": {
            "type": "string",
            "required": true,
            "maxLength": 150
        },
        "slug": {
            "type": "uid",
            "targetField": "name"
        },
        "logo": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images"
            ]
        },
        "website_url": {
            "type": "string"
        },
        "description": {
            "type": "text",
            "maxLength": 600
        },
        "role_in_alliance": {
            "type": "string",
            "maxLength": 200
        },
        "focus_areas": {
            "type": "string",
            "maxLength": 300,
            "description": "Comma-separated focus areas, e.g. \"Premix Supply, Market Assessments\""
        },
        "contact_email": {
            "type": "email"
        },
        "contact_phone": {
            "type": "string",
            "maxLength": 40
        },
        "member_organizations": {
            "type": "component",
            "component": "shared.member-organization",
            "repeatable": true
        },
        "order": {
            "type": "integer",
            "default": 0
        },
        "is_active": {
            "type": "boolean",
            "default": true
        },
        "partner_type": {
            "type": "enumeration",
            "enum": [
                "government",
                "private-sector",
                "professional-body",
                "development-partner",
                "civil-society"
            ],
            "default": "government"
        }
    }
}
