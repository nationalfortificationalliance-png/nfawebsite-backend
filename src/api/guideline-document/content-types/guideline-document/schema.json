{
    "kind": "collectionType",
    "collectionName": "guideline_documents",
    "info": {
        "singularName": "guideline-document",
        "pluralName": "guideline-documents",
        "displayName": "Resources – Guidelines & Documents",
        "description": "Regulatory guidelines, PDFs and technical documents"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "title": {
            "type": "string",
            "required": true,
            "maxLength": 255
        },
        "description": {
            "type": "text",
            "maxLength": 600
        },
        "file": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "files",
                "images",
                "videos"
            ]
        },
        "issuing_organization": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::member-organization.member-organization"
        },
        "access_type": {
            "type": "enumeration",
            "enum": [
                "Download",
                "Preview",
                "External Link"
            ],
            "default": "Download"
        },
        "external_url": {
            "type": "string",
            "maxLength": 500
        },
        "reference_number": {
            "type": "string",
            "maxLength": 80
        },
        "resource_group": {
            "type": "string",
            "maxLength": 120
        },
        "publication_year": {
            "type": "integer",
            "min": 1900,
            "max": 2100
        },
        "category": {
            "type": "enumeration",
            "enum": [
                "General",
                "Logistics",
                "Nutrition",
                "Reports",
                "Other"
            ],
            "default": "General",
            "required": true
        },
        "published_date": {
            "type": "date"
        },
        "file_size": {
            "type": "string"
        },
        "is_featured": {
            "type": "boolean",
            "default": false
        },
        "document_type": {
            "type": "enumeration",
            "enum": [
                "Guideline",
                "Standard",
                "Regulation",
                "Manual",
                "SOP",
                "Technical Note",
                "Policy Document",
                "Code of Practice"
            ]
        },
        "food_vehicles": {
            "type": "string",
            "maxLength": 200,
            "description": "Comma-separated, e.g. \"Salt, Vegetable Oil\""
        },
        "agency": {
            "type": "enumeration",
            "enum": [
                "NAFDAC",
                "SON",
                "FCCPC",
                "FMoH&SW",
                "NFA Secretariat",
                "Development Partners"
            ]
        },
        "status": {
            "type": "enumeration",
            "enum": [
                "Current",
                "Revised",
                "Archived"
            ],
            "default": "Current"
        }
    }
}
