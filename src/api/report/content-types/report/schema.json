{
    "kind": "collectionType",
    "collectionName": "reports",
    "info": {
        "singularName": "report",
        "pluralName": "reports",
        "displayName": "Reports & Data – Documents",
        "description": "Compliance, surveillance, research, and evaluation reports for the Reports & Data repository"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "title": {
            "type": "string",
            "required": true,
            "maxLength": 255
        },
        "description": {
            "type": "text",
            "maxLength": 600
        },
        "file": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "files"
            ]
        },
        "year": {
            "type": "string",
            "required": true,
            "maxLength": 20
        },
        "agency": {
            "type": "enumeration",
            "enum": [
                "NAFDAC",
                "SON",
                "FCCPC",
                "FMoH&SW",
                "NFA Secretariat",
                "Development Partners"
            ],
            "required": true
        },
        "report_type": {
            "type": "enumeration",
            "enum": [
                "Annual Report",
                "Quarterly Report",
                "Compliance Report",
                "Surveillance Report",
                "Laboratory Report",
                "Evaluation Report",
                "Policy Brief"
            ],
            "required": true
        },
        "food_vehicles": {
            "type": "string",
            "maxLength": 200,
            "description": "Comma-separated, e.g. \"Salt, Vegetable Oil\""
        },
        "topics": {
            "type": "string",
            "maxLength": 300,
            "description": "Comma-separated, e.g. \"Compliance, Vitamin A\""
        },
        "published_date": {
            "type": "date"
        },
        "file_size": {
            "type": "string",
            "maxLength": 20
        },
        "is_featured": {
            "type": "boolean",
            "default": false
        },
        "download_count": {
            "type": "integer",
            "default": 0
        },
        "order": {
            "type": "integer",
            "default": 0
        }
    }
}
