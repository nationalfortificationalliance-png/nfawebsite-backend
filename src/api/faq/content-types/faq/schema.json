{
    "kind": "collectionType",
    "collectionName": "faqs",
    "info": {
        "singularName": "faq",
        "pluralName": "faqs",
        "displayName": "FAQ – Questions",
        "description": "Frequently asked questions shown on the FAQ page"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "question": {
            "type": "string",
            "required": true,
            "maxLength": 300
        },
        "answer": {
            "type": "text",
            "required": true
        },
        "category": {
            "type": "string",
            "maxLength": 100
        },
        "order": {
            "type": "integer",
            "default": 0
        },
        "is_active": {
            "type": "boolean",
            "default": true
        },
        "view_count": {
            "type": "integer",
            "default": 0,
            "min": 0
        }
    }
}
