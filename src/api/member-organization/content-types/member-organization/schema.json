{
    "kind": "collectionType",
    "collectionName": "member_organizations",
    "info": {
        "singularName": "member-organization",
        "pluralName": "member-organizations",
        "displayName": "Member Organization",
        "description": "NFA membership entries (Core Members and Stakeholders)"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "name": {
            "type": "string",
            "required": true,
            "maxLength": 255
        },
        "category": {
            "type": "enumeration",
            "enum": [
                "Core Members",
                "Stakeholders"
            ],
            "default": "Core Members"
        },
        "logo": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "images"
            ]
        },
        "is_active": {
            "type": "boolean",
            "default": true
        },
        "order": {
            "type": "integer",
            "default": 0
        }
    }
}
