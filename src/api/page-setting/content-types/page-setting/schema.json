{
  "kind": "collectionType",
  "collectionName": "page_settings",
  "info": {
    "singularName": "page-setting",
    "pluralName": "page-settings",
    "displayName": "Page Setting",
    "description": "Hero images and settings for individual pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "page_key": {
      "type": "enumeration",
      "enum": [
        "initiatives",
        "partners",
        "news",
        "faq",
        "guidelines",
        "contact",
        "governance",
        "secretariat"
      ],
      "required": true,
      "unique": true
    },
    "hero_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "hero_title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "hero_description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
