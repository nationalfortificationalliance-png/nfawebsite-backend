{
    "kind": "collectionType",
    "collectionName": "meeting_schedules",
    "info": {
        "singularName": "meeting-schedule",
        "pluralName": "meeting-schedules",
        "displayName": "Meeting Schedule",
        "description": "NFA biannual meeting host rotation, by year"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "year": {
            "type": "string",
            "required": true,
            "maxLength": 20
        },
        "june_host": {
            "type": "string",
            "required": true,
            "maxLength": 100
        },
        "december_host": {
            "type": "string",
            "required": true,
            "maxLength": 100
        },
        "is_active": {
            "type": "boolean",
            "default": true
        },
        "order": {
            "type": "integer",
            "default": 0
        }
    }
}
