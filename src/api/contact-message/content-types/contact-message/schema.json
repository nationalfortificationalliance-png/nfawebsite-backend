{
    "kind": "collectionType",
    "collectionName": "contact_messages",
    "info": {
        "singularName": "contact-message",
        "pluralName": "contact-messages",
        "displayName": "Contact Message",
        "description": "User inquiries from the website"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "name": {
            "type": "string",
            "required": true
        },
        "email": {
            "type": "email",
            "required": true
        },
        "subject": {
            "type": "string",
            "required": true
        },
        "message": {
            "type": "text",
            "required": true
        },
        "attachments": {
            "type": "media",
            "multiple": true,
            "required": false,
            "allowedTypes": ["files"]
        },
        "isRead": {
            "type": "boolean",
            "default": false
        }
    }
}
