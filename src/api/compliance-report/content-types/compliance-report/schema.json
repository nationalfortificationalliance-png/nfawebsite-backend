{
    "kind": "collectionType",
    "collectionName": "compliance_reports",
    "info": {
        "singularName": "compliance-report",
        "pluralName": "compliance-reports",
        "displayName": "Reports & Data – Compliance Dashboard",
        "description": "Annual national fortification compliance figures, by year, for the Reports & Data compliance dashboard"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "year": {
            "type": "string",
            "required": true,
            "maxLength": 20
        },
        "national_compliance": {
            "type": "string",
            "required": true,
            "maxLength": 20
        },
        "salt_compliance": {
            "type": "string",
            "maxLength": 20
        },
        "veg_oil_compliance": {
            "type": "string",
            "maxLength": 20
        },
        "flour_compliance": {
            "type": "string",
            "maxLength": 20
        },
        "sugar_compliance": {
            "type": "string",
            "maxLength": 20
        },
        "rice_compliance": {
            "type": "string",
            "maxLength": 20
        },
        "bouillon_compliance": {
            "type": "string",
            "maxLength": 20
        },
        "source": {
            "type": "string",
            "maxLength": 255
        },
        "is_active": {
            "type": "boolean",
            "default": true
        },
        "order": {
            "type": "integer",
            "default": 0
        }
    }
}
