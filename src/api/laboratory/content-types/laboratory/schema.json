{
    "kind": "collectionType",
    "collectionName": "laboratories",
    "info": {
        "singularName": "laboratory",
        "pluralName": "laboratories",
        "displayName": "Resources – Approved Laboratories",
        "description": "Approved micronutrient testing laboratories"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "name": {
            "type": "string",
            "required": true,
            "maxLength": 200
        },
        "location": {
            "type": "string",
            "required": true,
            "maxLength": 100
        },
        "contact": {
            "type": "string",
            "required": true,
            "maxLength": 50
        },
        "email": {
            "type": "email"
        },
        "address": {
            "type": "text"
        },
        "services": {
            "type": "richtext"
        },
        "accreditation": {
            "type": "string"
        },
        "is_active": {
            "type": "boolean",
            "default": true
        },
        "order": {
            "type": "integer",
            "default": 0
        }
    }
}
