{
    "kind": "collectionType",
    "collectionName": "governance_representatives",
    "info": {
        "singularName": "governance-representative",
        "pluralName": "governance-representatives",
        "displayName": "Governance Representative",
        "description": "NFA leadership/representative profiles shown on the Governance & Compliance page"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "name": {
            "type": "string",
            "required": true
        },
        "title": {
            "type": "string",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "organization_name": {
            "type": "string",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "organization_short_name": {
            "type": "string"
        },
        "organization_key": {
            "type": "enumeration",
            "enum": [
                "NAFDAC",
                "SON",
                "FMOHSW",
                "FCCPC",
                "Industry",
                "Development Partners"
            ],
            "required": true
        },
        "photo": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images"
            ]
        },
        "bio": {
            "type": "text",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "organization_profile": {
            "type": "text",
            "required": false,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "key_contributions": {
            "type": "component",
            "repeatable": true,
            "component": "shared.bullet-point"
        },
        "order": {
            "type": "integer",
            "default": 0
        },
        "is_active": {
            "type": "boolean",
            "default": true
        }
    }
}
