{
  "kind": "collectionType",
  "collectionName": "statistics",
  "info": {
    "singularName": "statistic",
    "pluralName": "statistics",
    "displayName": "Statistic",
    "description": "Key statistics and metrics for NFA"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "value": {
      "type": "string",
      "required": true,
      "maxLength": 50
    },
    "description": {
      "type": "text",
      "maxLength": 400
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "General",
        "Compliance",
        "Health Impact",
        "Programme"
      ],
      "default": "General"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  }
}
