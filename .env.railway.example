# Railway Environment Variables Template
# Copy these to your Railway project's environment variables

# Server
HOST=0.0.0.0
PORT=1337
NODE_ENV=production

# Database (Railway will provide DATABASE_URL automatically when you add PostgreSQL)
DATABASE_CLIENT=postgres
DATABASE_URL=${DATABASE_URL}
DATABASE_SSL=false

# Secrets (Generate new secure values for production!)
APP_KEYS=generate-new-key-1,generate-new-key-2,generate-new-key-3,generate-new-key-4
API_TOKEN_SALT=generate-new-api-token-salt
ADMIN_JWT_SECRET=generate-new-admin-jwt-secret
TRANSFER_TOKEN_SALT=generate-new-transfer-token-salt
JWT_SECRET=generate-new-jwt-secret

# Optional: CORS settings
# FRONTEND_URL=https://your-frontend-domain.com

# NOTE: File uploads are stored in Railway volume at /app/public/uploads
# Make sure you've added a volume in Railway Settings with mount path: /app/public/uploads
